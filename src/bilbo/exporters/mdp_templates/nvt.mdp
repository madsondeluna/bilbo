; NVT equilibration — CHARMM36
integrator      = md
nsteps          = 50000        ; 100 ps
dt              = 0.002

nstxout         = 500
nstvout         = 500
nstenergy       = 500
nstlog          = 500

continuation    = no
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4

cutoff-scheme   = Verlet
nstlist         = 10
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16
rcoulomb        = 1.2
vdwtype         = cutoff
vdw-modifier    = force-switch
rvdw-switch     = 1.0
rvdw            = 1.2
DispCorr        = no

tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 310.15

pcoupl          = no

pbc             = xyz
gen_vel         = yes
gen_temp        = 310.15
gen_seed        = -1
