          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"
          edge="1" source="s3" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4 → 5  (fan-out left) -->
        <mxCell id="e45" value="multipart/form-data (PDB files, build params)"
