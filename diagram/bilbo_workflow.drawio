        <mxCell id="e810" value="assembled PDB, GRO, topology, leaflet PNG"
          style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"
          edge="1" source="s8" target="s10" parent="1">
