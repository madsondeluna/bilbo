        </mxCell>

        <!-- 8. SERVICE / BUSINESS LOGIC -->
        <mxCell id="s8"
          value="&lt;b&gt;8. SERVICE / BUSINESS LOGIC&lt;/b&gt;&lt;br/&gt;bilbo.builders.* (layout, geometry, sorting)&lt;br/&gt;bilbo.exporters.* (PDB, GRO, topology, PNG)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=10;"
          vertex="1" parent="1">
