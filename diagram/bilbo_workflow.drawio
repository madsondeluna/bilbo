        <!-- ── SIDE PANELS ─────────────────────────────────────────────────── -->

        <!-- Stack -->
        <mxCell id="p1"
          value="&lt;b&gt;Stack&lt;/b&gt;&lt;br/&gt;Framework: FastAPI (Python 3.11)&lt;br/&gt;Server: uvicorn (ASGI, single process)&lt;br/&gt;DB: SQLAlchemy 2 — SQLite (dev) / PostgreSQL (prod)&lt;br/&gt;Frontend: Vanilla JS SPA (single static HTML)&lt;br/&gt;Key libs: NumPy, pydantic, python-multipart,&lt;br/&gt;  psycopg2-binary, matplotlib&lt;br/&gt;Build: uv + hatchling"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="740" y="65" width="270" height="175" as="geometry" />
        </mxCell>

        <!-- Deployment -->
        <mxCell id="p2"
          value="&lt;b&gt;Deployment&lt;/b&gt;&lt;br/&gt;Platform: Render web service (Docker, free tier)&lt;br/&gt;Region: Oregon&lt;br/&gt;Domain: bilbo.delunalab.dev&lt;br/&gt;Start: uvicorn web.app:app --host 0.0.0.0&lt;br/&gt;Health: GET /health → {status: ok}&lt;br/&gt;Env vars: DATABASE_URL, RESEND_API_KEY,&lt;br/&gt;  RESEND_FROM_EMAIL, TELEGRAM_BOT_TOKEN,&lt;br/&gt;  TELEGRAM_CHAT_ID, PORT (default 8000)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="740" y="255" width="270" height="205" as="geometry" />
        </mxCell>

        <!-- Data Model -->
        <mxCell id="p3"
          value="&lt;b&gt;Data Model&lt;/b&gt;&lt;br/&gt;stats(key TEXT PK, value BIGINT)&lt;br/&gt;  keys: total_builds, total_atoms,&lt;br/&gt;         unique_sessions&lt;br/&gt;sessions(id TEXT PK)&lt;br/&gt;  UUID per browser (_bilbo_sid cookie)&lt;br/&gt;Note: bilayer data is never persisted;&lt;br/&gt;  all membrane computation is in-memory"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="740" y="475" width="270" height="175" as="geometry" />
        </mxCell>

        <!-- External APIs -->
        <mxCell id="p4"
          value="&lt;b&gt;External APIs&lt;/b&gt;&lt;br/&gt;Resend (api.resend.com/emails)&lt;br/&gt;  transactional email, RESEND_API_KEY bearer&lt;br/&gt;  plain text + HTML, ZIP attachments (&gt;2 MB)&lt;br/&gt;  5 languages: EN, FR, ES, PT, ZH&lt;br/&gt;Telegram Bot API&lt;br/&gt;  per-build lab notification&lt;br/&gt;  fire-and-forget (background thread)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="740" y="665" width="270" height="175" as="geometry" />
        </mxCell>

        <!-- Auth / Security -->
        <mxCell id="p5"
          value="&lt;b&gt;Auth / Security&lt;/b&gt;&lt;br/&gt;No authentication — all endpoints fully public&lt;br/&gt;Session cookie: _bilbo_sid (analytics only)&lt;br/&gt;  HttpOnly, SameSite=Lax, TTL 1 year&lt;br/&gt;Upload limits: 20 MB gz / 100 MB plain text&lt;br/&gt;Admin /admin: publicly accessible (no gate)"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="740" y="855" width="270" height="140" as="geometry" />
        </mxCell>

