        </mxCell>

        <!-- ── MAIN-FLOW STAGES ─────────────────────────────────────────────── -->

        <!-- 1. CLIENT -->
        <mxCell id="s1"
          value="&lt;b&gt;1. CLIENT&lt;/b&gt;&lt;br/&gt;Browser SPA (index.html)&lt;br/&gt;JavaScript fetch() API calls"
