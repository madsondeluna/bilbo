        </mxCell>

        <!-- 10. RESPONSE -->
        <mxCell id="s10"
          value="&lt;b&gt;10. RESPONSE&lt;/b&gt;&lt;br/&gt;JSON 200 / binary ZIP / plain text&lt;br/&gt;PDB + GRO + topology + leaflet PNG (base64)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;arcSize=10;"
